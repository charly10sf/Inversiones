rules_version = '2';
// Reglas de Firestore de GrowFolio (se pegan en Firebase > Firestore Database > Reglas > Publicar).
service cloud.firestore {
  match /databases/{database}/documents {
    // el dueño de GrowFolio: los correos de BANCO_EMAILS (ver opiniones, abajo)
    function esDueno() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [__DUENOS__];
    }
    // la cartera de cada cuenta: solo la lee y la escribe su dueño (va cifrada con la contraseña de su cartera)
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // opiniones y fallos: cualquiera con cuenta puede mandar una (a su nombre y con texto). Las lee el dueño (y cada uno las suyas),
    // desde Ajustes > Opiniones recibidas (y en la consola de Firebase). __DUENOS__ no se queda así: la Action «Reglas
    // de Firestore» lo cambia al publicar por los correos del secreto BANCO_EMAILS, que no están en el repositorio.
    // Si se pegan a mano en la consola, hay que cambiarlo por 'tu@correo' (o por nada, y no las lee nadie).
    // 0.4: el dueño puede responder a cada una (respuesta, respondida, por, y «vista» a falso para que salga como
    // nueva), y quien la mandó la lee con su respuesta y solo puede marcarla como vista.
    match /opiniones/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 4000
        && !('respuesta' in request.resource.data);
      allow read: if esDueno() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if (esDueno()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respuesta', 'respondida', 'por', 'vista'])
          && request.resource.data.respuesta is string
          && request.resource.data.respuesta.size() > 0
          && request.resource.data.respuesta.size() <= 2000)
        || (request.auth != null && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vista'])
          && request.resource.data.vista == true);
      allow delete: if false;
    }
    // 0.5: modo fundador o estándar de cada cuenta, por su correo en minúsculas. Lo pone, lo lista y lo quita solo el
    // dueño (con una nota corta opcional para esa persona); cada cuenta solo puede leer el suyo, con el correo confirmado
    // (Google y Apple lo traen confirmado; con correo y contraseña, al confirmarlo).
    match /modos/{correo} {
      allow get: if esDueno() || (request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == correo);
      allow list, delete: if esDueno();
      allow create, update: if esDueno() && correo == correo.lower() && correo.matches('^[^@/ ]+@[^@/ ]+$')
        && request.resource.data.keys().hasOnly(['modo', 'por', 'cuando', 'nota'])
        && request.resource.data.modo in ['fundador', 'estandar']
        && (!('nota' in request.resource.data) || (request.resource.data.nota is string && request.resource.data.nota.size() <= 140));
    }
    // 0.5: cada cuenta apunta su correo y su fecha de alta (nada más), para que el dueño las vea todas en Ajustes y
    // pueda cambiarles el modo. Solo la escribe su dueño, con su propio correo; la lee él y el dueño de GrowFolio.
    match /cuentas/{uid} {
      allow get: if esDueno() || (request.auth != null && request.auth.uid == uid);
      allow list: if esDueno();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['correo', 'alta'])
        && request.resource.data.correo == request.auth.token.email.lower()
        && request.resource.data.alta is string && request.resource.data.alta.size() <= 10;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // 0.7: los fallos de GrowIA que no se arreglan solos (la conexión se corta tres veces, Google no contesta, la clave
    // falla…), para que el dueño los vea sin que nadie se lo cuente. Sin la pregunta, sin la respuesta y sin nada de la
    // cartera: de qué tipo, con qué modelo, dónde (chat, revisión…), el código de Google y la versión. Cualquiera con
    // cuenta puede apuntar uno a su nombre; solo los lee y los borra el dueño. Revisión aparte: el tope de 5 al día lo
    // ponen estas reglas (el id es «<uid>_<AAAAMMDD de hoy en UTC>_<0 a 4>» y no se puede reescribir), la hora la pone
    // el servidor, el modelo y la versión tienen su forma (nada de texto libre) y «caduca» (de 1 a 31 días) es el campo
    // del TTL de Firestore que los borra solos.
    match /fallos_ia/{id} {
      allow create: if request.auth != null
        && id.matches('^' + request.auth.uid + '_' + string(request.time.year() * 10000 + request.time.month() * 100 + request.time.day()) + '_[0-4]$')
        && request.resource.data.keys().hasOnly(['t', 'caduca', 'tipo', 'estado', 'modelo', 'donde', 'v'])
        && request.resource.data.t == request.time
        && request.resource.data.caduca is timestamp
        && request.resource.data.caduca > request.time + duration.value(1, 'd')
        && request.resource.data.caduca < request.time + duration.value(31, 'd')
        && request.resource.data.tipo in ['corte', 'red', 'cupo', 'espera', 'google', 'clave', 'peticion', 'bloqueo', 'vacia', 'formato', 'otro']
        && (request.resource.data.estado == null || (request.resource.data.estado is int && request.resource.data.estado >= 0 && request.resource.data.estado < 1000))
        && (request.resource.data.modelo == null || (request.resource.data.modelo is string && request.resource.data.modelo.matches('^gemini-[0-9a-z.-]{1,32}$')))
        && request.resource.data.donde in ['chat', 'revision', 'busqueda', 'noticia', 'captura']
        && request.resource.data.v is string && request.resource.data.v.matches('^[0-9]{1,2}[.][0-9]{1,2}[a-z]?$');
      allow read, delete: if esDueno();
      allow update: if false;
    }
    // precios que pedir: el ticker o el ISIN de lo que alguien mete a mano y GrowFolio no seguía (sin quién lo
    // pide). Cualquiera con cuenta puede apuntar uno nuevo; lo lee la Action de precios, sin clave
    match /simbolos/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && id.matches('^[A-Z0-9][A-Z0-9.-]{0,19}$')
        && request.resource.data.keys().hasOnly(['s', 'isin', 'cuando'])
        && request.resource.data.s is string && request.resource.data.s.size() <= 20
        && request.resource.data.isin is string && request.resource.data.isin.size() <= 12;
      allow update, delete: if false;
    }
  }
}
