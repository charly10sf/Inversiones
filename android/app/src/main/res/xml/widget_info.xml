<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 casillas al ponerlo; se puede estirar o encoger: de una fila (el total, hoy y una gráfica pequeña)
     a 4x4 (además lo que toca y lo que más se mueve hoy). Se dibuja entero a su tamaño, con Plus Jakarta Sans. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="700dp"
    android:maxResizeHeight="600dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_lienzo"
    android:previewLayout="@layout/widget_vista_previa"
    android:previewImage="@drawable/vista_previa"
    android:description="@string/widget_descripcion"
    android:widgetCategory="home_screen" />
