<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_widget">

    <!-- el widget dibujado, en dos copias: al cambiar el plazo de la curva, la nueva entra fundiéndose con la de antes -->
    <ViewFlipper
        android:id="@+id/lienzos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateFirstView="false"
        android:inAnimation="@anim/plazo_entra"
        android:outAnimation="@anim/plazo_sale">

        <ImageView
            android:id="@+id/lienzo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Tu cartera"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/lienzo2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Tu cartera"
            android:scaleType="fitXY" />
    </ViewFlipper>

    <!-- los plazos de la curva, encima de los que dibuja Lienzo.selector (arriba a la derecha, acaban a 38 dp del borde,
         junto a refrescar, y cada uno mide 34): 24 horas, 1 semana, 1 mes, 3 meses y 1 año. Al tocarlos se ilumina la
         pastilla y cambia la curva -->
    <LinearLayout
        android:id="@+id/plazos"
        android:layout_width="170dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="38dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/plazo0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/plazo_toque"
            android:contentDescription="Últimas 24 horas" />

        <FrameLayout
            android:id="@+id/plazo1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/plazo_toque"
            android:contentDescription="1 semana" />

        <FrameLayout
            android:id="@+id/plazo2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/plazo_toque"
            android:contentDescription="1 mes" />

        <FrameLayout
            android:id="@+id/plazo3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/plazo_toque"
            android:contentDescription="3 meses" />

        <FrameLayout
            android:id="@+id/plazo4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/plazo_toque"
            android:contentDescription="1 año" />
    </LinearLayout>

    <!-- en los widgets estrechos, una sola pastilla con el plazo: al tocarla pasa al siguiente -->
    <FrameLayout
        android:id="@+id/periodo"
        android:layout_width="84dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="38dp"
        android:contentDescription="Cambiar el plazo de la gráfica"
        android:visibility="gone" />

    <!-- refrescar: la rueda quieta y, mientras baja los precios, la misma rueda en dorado dando vueltas
         (centrada a 19 dp del borde y a 21 de arriba, a la altura de los plazos) -->
    <FrameLayout
        android:id="@+id/refrescar"
        android:layout_width="38dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:background="@drawable/refresco_toque"
        android:contentDescription="Refrescar">

        <ImageView
            android:id="@+id/refresco_ico"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="9dp"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"
            android:src="@drawable/refresco" />

        <ProgressBar
            android:id="@+id/refresco_gira"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="9dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/refresco_gira"
            android:indeterminateDuration="850"
            android:indeterminateOnly="true"
            android:indeterminateTint="#FFEDBB45"
            android:indeterminateTintMode="src_in"
            android:maxWidth="24dp"
            android:maxHeight="24dp"
            android:minWidth="24dp"
            android:minHeight="24dp"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
