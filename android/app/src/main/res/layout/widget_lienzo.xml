<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_widget">

    <ImageView
        android:id="@+id/lienzo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Tu cartera"
        android:scaleType="fitXY" />

    <!-- zona invisible encima del icono de refrescar -->
    <FrameLayout
        android:id="@+id/refrescar"
        android:layout_width="56dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:contentDescription="Refrescar" />
</FrameLayout>
