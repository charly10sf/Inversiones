<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- para instalar la versión nueva de la app desde el aviso de la web -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 0.3.11e: que la app se actualice sola, sin tocar «Instalar» (Android 12 o más) -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- los avisos (solo si los activas en Ajustes > Avisos y resumen) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 0.7f: que GrowIA siga contestando con la app en segundo plano (un servicio con su notificación, solo mientras
         contesta). Android 14 o más usa shortService, que no pide permiso aparte; antes, dataSync -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="GrowFolio"
        android:supportsRtl="false"
        android:theme="@style/Tema">

        <activity
            android:name=".Principal"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- para que Chrome pueda abrir la app desde la web (botón "Pasar el token a la app") -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="inversiones" android:host="token" />
                <!-- la vuelta de dar permiso al banco, cuando el banco la abre en el navegador -->
                <data android:scheme="inversiones" android:host="banco" />
            </intent-filter>
            <!-- la vuelta de la app del banco (Trade Republic y otras): su enlace de Enable Banking se abre aquí, donde está
                 la sesión del permiso. Android pide permitirlo una vez en «Abrir de forma predeterminada» -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="auth.enablebanking.com" />
                <data android:host="tilisy.enablebanking.com" />
            </intent-filter>
        </activity>

        <provider
            android:name=".Archivos"
            android:authorities="es.inversiones.app.archivos"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".GrowiaServicio"
            android:exported="false"
            android:foregroundServiceType="shortService|dataSync" />

        <receiver
            android:name=".Instalado"
            android:exported="false" />

        <receiver
            android:name=".Widget"
            android:exported="true"
            android:label="Tu cartera">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
