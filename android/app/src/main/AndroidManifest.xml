<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- para instalar la versión nueva de la app desde el aviso de la web -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="GrowFolio"
        android:supportsRtl="false"
        android:theme="@style/Tema">

        <activity
            android:name=".Principal"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- para que Chrome pueda abrir la app desde la web (botón "Pasar el token a la app") -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="inversiones" android:host="token" />
            </intent-filter>
        </activity>

        <provider
            android:name=".Archivos"
            android:authorities="es.inversiones.app.archivos"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".Widget"
            android:exported="true"
            android:label="Tu cartera">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
